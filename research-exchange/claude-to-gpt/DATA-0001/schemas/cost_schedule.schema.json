{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "COST_SCHEDULE payload",
 "type": "object",
 "required": [
  "component",
  "rate",
  "valid_from",
  "valid_to",
  "source_ref"
 ],
 "properties": {
  "component": {
   "enum": [
    "FEE",
    "TAX",
    "SLIPPAGE"
   ]
  },
  "rate": {
   "type": "string"
  },
  "valid_from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "valid_to": {
   "type": [
    "string",
    "null"
   ]
  },
  "source_ref": {
   "type": "string"
  }
 }
}