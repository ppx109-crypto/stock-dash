{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "UNIVERSE_SNAPSHOT payload",
 "type": "object",
 "required": [
  "date",
  "market",
  "complete",
  "members"
 ],
 "properties": {
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "complete": {
   "type": "boolean"
  },
  "members": {
   "type": "array"
  }
 }
}