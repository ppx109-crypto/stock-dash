 "formulas": {
  "nav": "NAV_t = cash + Σ qty × 표시가격(그날 시세 있으면 시세, 없으면 앞 표시가격)",
  "r": "r_t = NAV_t/NAV_{t-1} − 1(외부 현금흐름 0)",
  "monthly": "달력월 TWR = Π(1 + r_t) − 1",
  "mdd": "max_t (peak_t − NAV_t)/peak_t",
  "atomic": "사건 당일: 복사본에서 (qty × m_qty, 표시가격 × m_price)를 함께 바꾼 뒤 한 번에 커밋 → 그 뒤 snapshot",
  "invariance": "qty·m_qty × price·m_price = qty × price (m_qty·m_price = 1)"
 }
}