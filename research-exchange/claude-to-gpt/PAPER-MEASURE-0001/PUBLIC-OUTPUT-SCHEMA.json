{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "PAPER-MEASURE-0001 공개 비식별 일별 성과",
 "x-visibility": "PUBLIC — 허용 필드만. build_daily_measurement.public_guard + whitelist_guard가 쓰기 전에 검사",
 "x-forbidden_key_regex": "account|acnt|cano|order|odno|ord_no|token|secret|appkey|raw|response|balance|quantity|qty|amount|krw|price(?!_source)|branch|brno|hmac|uid|equity",
 "x-forbidden_value": [
  "계좌 · 주문 같은 숫자열(8-2자리 · 10자리 이상)",
  "절댓값 1e6 이상 숫자(원 단위 금액 · 수량 추정)"
 ],
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "completeness": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "corp_actions_declared": {},
    "cost_missing_fills": {},
    "fill_at_basis": {},
    "impossible_fill_days": {},
    "missing_field_counts": {},
    "start_state": {},
    "valuation_missing_days": {}
   }
  },
  "cost_bps": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "actual": {},
    "assumed": {},
    "missing_fills": {},
    "n_fills": {}
   }
  },
  "data_status": {},
  "day_alerts": {},
  "days": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "cash_weight": {},
     "date": {},
     "day_loss_alert": {},
     "fills_confirmed": {},
     "nav_norm": {},
     "reason": {},
     "status": {},
     "twr_day": {},
     "utilization": {}
    }
   }
  },
  "days_total": {},
  "days_valid": {},
  "fills_confirmed": {},
  "first_invalid": {},
  "kind": {},
  "loss_limit": {},
  "mdd_daily_mtm": {},
  "month_alerts": {},
  "months": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "days": {},
     "month": {},
     "month_loss_alert": {},
     "partial": {},
     "reason": {},
     "status": {},
     "twr_month": {}
    }
   }
  },
  "notes": {},
  "period": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "from": {},
    "to": {}
   }
  },
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "fill_source": {},
    "generator_commit": {},
    "price_source": {},
    "schema_version": {},
    "tool": {}
   }
  },
  "rejected_counts": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "cancelled": {},
    "confirmed": {},
    "duplicate": {},
    "input_rows": {},
    "same_time_opposite_side": {},
    "unfilled": {}
   }
  },
  "schema_version": {},
  "slippage_bps": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "buy_mean": {},
    "buy_n": {},
    "null_no_reference": {},
    "sell_mean": {},
    "sell_n": {}
   }
  },
  "worst_day_twr": {},
  "worst_month_twr": {}
 },
 "x-definitions": {
  "twr_day": "E_t ÷ (E_{t−1} + 그날 시작 외부 입출금) − 1",
  "nav_norm": "첫 평가일 시작 1.0에서 일별 TWR 누적",
  "mdd_daily_mtm": "정규화 NAV ÷ 그때까지 최고(시작 1.0 포함) − 1의 최솟값",
  "twr_month": "그 달 일별 (1+r) 곱 − 1, 그 달에 null 날 있으면 null",
  "day_loss_alert / month_loss_alert": "−15%보다 나쁠 때만 true(관측 경보 · 보장 아님)",
  "utilization": "보유 평가액 ÷ 총 평가액",
  "cash_weight": "현금 ÷ 총 평가액",
  "cost_bps": "실제 · 가정 비용 ÷ 체결금액 × 10,000",
  "slippage_bps": "매수 (체결가−기준가)/기준가, 매도 (기준가−체결가)/기준가 × 10,000. 기준가 출처 없으면 null",
  "status/reason": "null 이유: START_VALUATION_MISSING · COSTS_MISSING · IMPOSSIBLE_FILL · VALUATION_MISSING · EQUITY_NONPOSITIVE. 사슬이 끊기면 뒤도 null"
 }
}