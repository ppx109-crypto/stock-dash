의견서를 참고하시기 바랍니다.\n\n상기와 같이 합병법인이 피합병법인을 흡수합병함에 있어서 합병비율의 기준이 되는 합병당사회사의 보통주 주당평가액은 합병법인과 피합병법인이 각각 66,831원(액면가액500원)과\n14,245원(액면가액5,000원)으로 산출되었습니다. \n\n이에 따라 합병비율은 보통주 1 : 0.2131444로 결정되었습니다.","mgnstk_ostk_cnt":"2,131,365","mgnstk_cstk_cnt":"-","mgptncmp_cmpnm":"㈜포스코ESM","mgptncmp_mbsn":"이차전지 소재(양극활물질) 제조업","mgptncmp_rl_cmpn":"계열회사","rbsnfdtl_tast":"121,453,040,199","rbsnfdtl_tdbt":"49,689,359,200","rbsnfdtl_teqt":"71,763,680,999","rbsnfdtl_cpt":"20,261,150,000","rbsnfdtl_sl":"33,413,802,735","rbsnfdtl_nic":"-9,257,482,783","eadtat_intn":"한영회계법인","eadtat_op":"적정","nmgcmp_cmpnm":"-","ffdtl_tast":"-","ffdtl_tdbt":"-","ffdtl_teqt":"-","ffdtl_cpt":"-","ffdtl_std":"-","nmgcmp_nbsn_rsl":"-","nmgcmp_mbsn":"-","nmgcmp_rlst_atn":"해당사항없음","mgsc_mgctrd":"2018년 12월 10일","mgsc_shddstd":"2018년 12월 24일","mgsc_shclspd_bgd":"2018년 12월 25일","mgsc_shclspd_edd":"2018년 12월 26일","mgsc_mgop_rcpd_bgd":"2018년 12월 24일","mgsc_mgop_rcpd_edd":"2019년 01월 07일","mgsc_gmtsck_prd":"-","mgsc_aprskh_expd_bgd":"-","mgsc_aprskh_expd_edd":"-","mgsc_osprpd_bgd":"-","mgsc_osprpd_edd":"-","mgsc_trspprpd_bgd":"-","mgsc_trspprpd_edd":"-","mgsc_cdobprpd_bgd":"2019년 02월 08일","mgsc_cdobprpd_edd":"2019년 03월 29일","mgsc_mgdt":"2019년 04월 01일","mgsc_ergmd":"-","mgsc_mgrgsprd":"2019년 04월 03일","mgsc_nstkdlprd":"2019년 04월 17일","mgsc_nstklstprd":"2019년 04월 18일"}],"분할":[],"부도":[],"영업정지":[],"회생절차":[],"소송":[]},"받은날":{"자기주식취득":"20260929","자기주식처분":"20260929","자기주식신탁체결":"20260929","자기주식신탁해지":"20260929","유상증자":"20260929","무상증자":"20260929","유무상증자":"20260929","전환사채":"20260929","신주인수권부사채":"20260929","교환사채":"20260929","감자":"20260929","타법인주식양수":"20260929","타법인주식양도":"20260929","영업양수":"20260929","영업양도":"20260929","유형자산양수":"20260929","유형자산양도":"20260929","합병":"20260929","분할":"20260929","부도":"20260929","영업정지":"20260929","회생절차":"20260929","소송":"20260929"}}